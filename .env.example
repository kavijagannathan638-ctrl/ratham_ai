# RATHAM AI Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit the .env file with real secrets.

# Core
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (SQLite default, switch to PostgreSQL for production)
DATABASE_URL=sqlite:///./ratham_ai.db
# DATABASE_URL=postgresql+psycopg2://ratham:YOUR_PASSWORD@localhost:5432/ratham_db

# JWT Security
JWT_SECRET=change_this_to_a_secure_random_256bit_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ML Models
MODELS_DIR=../models
DATA_DIR=../data

# Notification Providers (leave empty for Mock mode)
WHATSAPP_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional: Redis (for caching and event streaming)
# REDIS_URL=redis://localhost:6379/0
